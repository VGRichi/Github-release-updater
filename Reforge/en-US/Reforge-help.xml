    <command:examples>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 1 --------------------------</maml:title>
        <dev:code>Add-ReforgeApp -Repository storytold/photocraft -Name PhotoCraft</dev:code>
        <dev:remarks>
          <maml:para>Tracks an app that was installed with an .msi or .exe.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 2 --------------------------</maml:title>
        <dev:code>Add-ReforgeApp -Repository doitsujin/dxvk -Name 'DXVK (Witcher 3)' -Destination 'D:\Games\Witcher 3\bin\x64' -Subfolder x64</dev:code>
        <dev:remarks>
          <maml:para>Tracks DXVK for one game, copying the archive's x64 folder into the game folder.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 3 --------------------------</maml:title>
        <dev:code>Add-ReforgeApp -Repository optiscaler/OptiScaler -Name 'OptiScaler (Cyberpunk)' -Destination 'D:\Games\Cyberpunk 2077\bin\x64' -Rename @{ 'OptiScaler.dll' = 'dxgi.dll' } -Keep '*.ini'</dev:code>
        <dev:remarks>
          <maml:para>Tracks OptiScaler, renaming its DLL and never overwriting your settings file.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 4 --------------------------</maml:title>
        <dev:code>$app = @{ Repository = 'storytold/pdfcraft'; Name = 'PdfCraft' }
Add-ReforgeApp @app</dev:code>
        <dev:remarks>
          <maml:para>Adds an app from a hashtable (splatting).</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 5 --------------------------</maml:title>
        <dev:code>Import-Csv .\my-apps.csv | Add-ReforgeApp</dev:code>
        <dev:remarks>
          <maml:para>Adds every row of a CSV file with Repository and Name columns.</maml:para>
        </dev:remarks>
      </command:example>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 6 --------------------------</maml:title>
        <dev:code>Find-ReforgeApp | Add-ReforgeApp</dev:code>
        <dev:remarks>
          <maml:para>Adds every installed app that Find-ReforgeApp found.</maml:para>
        </dev:remarks>
      </command:example>
    </command:examples>
