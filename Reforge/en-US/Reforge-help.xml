    <maml:description>
      <maml:para>Checks each app in your list against its latest GitHub release and installs newer versions.</maml:para>
      <maml:para>Installer apps (.msi/.exe) are compared with the version in Installed apps and installed silently. Apps installed for all users need PowerShell running as administrator; apps installed only for your account don't. Archive tools are extracted into their folders, with replaced files backed up first.</maml:para>
      <maml:para>Downloads with a GitHub checksum are verified before installing. Downloads without one are only installed after you confirm, or if the app is trusted (Add-ReforgeApp -AllowUnverified). If an app's earlier releases had checksums and a new one doesn't, it always asks.</maml:para>
      <maml:para>Use -WhatIf to see what would be updated without installing anything (no admin needed). Outputs one result per app.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Update-ReforgeApp</maml:name>
        <command:parameter required="false" variableLength="true" globbing="true" pipelineInput="True (ByPropertyName)" position="1" aliases="none">
          <maml:name>Name</maml:name>
          <maml:description>
            <maml:para>Only update apps whose name matches. Wildcards are supported. Defaults to all apps.</maml:para>
          </maml:description>
          <command:parameterValue required="true" variableLength="false">String[]</command:parameterValue>
          <dev:type>
            <maml:name>String[]</maml:name>
            <maml:uri />
          </dev:type>
          <dev:defaultValue>None</dev:defaultValue>
        </command:parameter>
        <command:parameter required="false" variableLength="true" globbing="false" pipelineInput="False" position="named" aliases="none">
