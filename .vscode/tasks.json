{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GitHub apps: check for updates",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "Import-Module '${workspaceFolder}/GitHubAppUpdater' -Force; Update-GitHubApp -WhatIf"],
      "problemMatcher": []
    },
    {
      "label": "GitHub apps: update all (run VS Code as admin for installers)",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "Import-Module '${workspaceFolder}/GitHubAppUpdater' -Force; Update-GitHubApp"],
      "problemMatcher": []
    },
    {
      "label": "GitHub apps: list",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "Import-Module '${workspaceFolder}/GitHubAppUpdater' -Force; Get-GitHubApp"],
      "problemMatcher": []
    },
    {
      "label": "GitHub apps: find installed GitHub apps",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "Import-Module '${workspaceFolder}/GitHubAppUpdater' -Force; Find-GitHubApp"],
      "problemMatcher": []
    }
  ]
}
